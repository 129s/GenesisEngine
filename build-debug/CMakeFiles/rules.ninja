#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = E:\msys64\mingw64\bin\cmake.exe --regenerate-during-build -SL:\CppProject\GenesisEngine -BL:\CppProject\GenesisEngine\build-debug
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = E:\msys64\mingw64\bin\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = E:\msys64\mingw64\bin\ninja.exe -t targets
  description = All primary targets available:

