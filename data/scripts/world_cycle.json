{
  "name": "world-db-cycle-demo",
  "commands": [
    {
      "label": "load-demo-world",
      "action": "world.db.load",
      "folder": "data/world_new",
      "waitForSuccess": true
    },
    {
      "label": "consume-food",
      "action": "resource.consume",
      "interactionId": 1000,
      "amount": 10,
      "waitForSuccess": true
    },
    {
      "label": "save-backup",
      "action": "world.db.save",
      "folder": "out/world_new_backup"
    }
  ]
}
